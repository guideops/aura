{
  "name": "@aura/desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "bundle:daemon": "node scripts/bundle-daemon.mjs",
    "gen:icons": "node scripts/gen-icon.mjs",
    "dist": "node scripts/gen-icon.mjs && node scripts/bundle-daemon.mjs && electron-builder --win --dir",
    "dist:installer": "node scripts/gen-icon.mjs && node scripts/bundle-daemon.mjs && electron-builder --win nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "@aura/daemon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.aura.desktop",
    "npmRebuild": false,
    "productName": "AURA",
    "directories": { "output": "dist-app" },
    "files": ["dist/**", "static/**", "package.json"],
    "extraResources": [
      { "from": "resources/daemon", "to": "daemon" },
      { "from": "resources/icons", "to": "icons" }
    ],
    "win": {
      "target": ["dir"],
      "icon": "resources/icons/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AURA-Setup-${version}.${ext}"
    }
  }
}
