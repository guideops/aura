{
  "name": "@aura/desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "bundle:daemon": "node scripts/bundle-daemon.mjs",
    "dist": "node scripts/bundle-daemon.mjs && electron-builder --win --dir",
    "test": "vitest run"
  },
  "dependencies": {
    "@aura/daemon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.aura.desktop",
    "productName": "AURA",
    "directories": { "output": "dist-app" },
    "files": ["dist/**", "static/**", "package.json"],
    "extraResources": [{ "from": "resources/daemon", "to": "daemon" }],
    "win": { "target": ["dir"], "signAndEditExecutable": false }
  }
}
